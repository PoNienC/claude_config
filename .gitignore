# ============================================================
# .gitignore for synced ~/.claude/ repo
# Goal: share config (rules, skills, agents, commands, hooks)
# Exclude: per-machine state, secrets, transient session data
# ============================================================

# --- Per-machine state (auto-generated by Claude Code) -------
projects/
todos/
shell-snapshots/
statsig/
ide/
*.log

# --- Per-machine session and history -------------------------
history.jsonl
.last-update-check
session-*.json

# --- Auth: bare names are NOT enough -------------------------
# Claude Code writes credentials atomically (temp file then rename).
# An interrupted write leaves an orphan like
# .credentials.json.tmp.54fd5dba holding LIVE OAuth tokens — access
# and refresh tokens for the account, plus any MCP server tokens
# (Slack et al). One such orphan was caught staged in the work config
# on 2026-08-24. Bare ".credentials.json" does not match it.
.credentials.json
.credentials.json.*
*.credentials.json*
oauth_account.json
oauth_account.json.*
.claude.json
.claude.json.*
*.tmp.*
*token*.json
buddy-tokens.json

# --- Local-only overrides ------------------------------------
settings.local.json
*.local.json
.env
.env.*
!.env.example

# --- OS clutter ----------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / tool artefacts ---------------------------------
.vscode/
.idea/
*.swp
*~

# --- Backups created by the installer ------------------------
settings.json.bak.*
*.backup
*.bak

# --- Anything you specifically want to keep machine-local ----
# Add patterns here for personal hooks you don't want to share
# e.g. work-only hooks, machine-specific notification scripts
hooks/local-*.sh

# --- Additional Mac runtime folders missed in initial draft -------
backups/
cache/
debug/
file-history/
plans/
mcp-needs-auth-cache.json
plugins/
sessions/

# --- Claude Code worktree internals (per-agent-session scratch) ---
.claude/

# --- GeoAI MCP server: sensitive zones never leave the machine ----
mcp_servers/geoai_mcp/references/sensitive_zones.geojson
mcp_servers/geoai_mcp/references/sensitive_zones.*.geojson

# --- Session transcript backups: NEVER commit ---------------------
# Raw .jsonl conversation history. Contains whatever was discussed —
# credentials, client data, file contents. Machine-local only.
_session_backup_premove/
_session_backup*/

# --- More runtime state (2026-07 sweep) ---------------------------
tasks/
telemetry/
scheduled-tasks/
.last-cleanup
.last-update-result.json

# --- Rendered diagram previews: code yes, megabytes of PNG no -----
tools/diagram_render/_preview/

# --- More runtime and generated output (7 October 2026) -----------
# session-env: per-session hook scripts written by the app.
# session_index: generated by the session_index command; lists session
# titles and folders, some personal (HR) - machine-local only.
session-env/
session_index/
__pycache__/
*.pyc

# --- Live session handovers (13 October 2026): personal, machine-local ---
handovers/

# --- Claude Code runtime state (15 October 2026): machine-local ---
state/
