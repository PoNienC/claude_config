{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledMcpjsonServers": [
    "geoai"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__geoai__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${HOME}/.claude/hooks/pre_tool_geoai_validate_crs.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__geoai__geoai_get_crs_info",
      "mcp__geoai__geoai_stac_search",
      "mcp__geoai__geoai_calculate_isochrone"
    ],
    "deny": [
      "mcp__3d45de2f-0c7e-4dfe-b321-df8f44b414c5__slack_send_message",
      "mcp__3d45de2f-0c7e-4dfe-b321-df8f44b414c5__slack_send_message_draft",
      "mcp__3d45de2f-0c7e-4dfe-b321-df8f44b414c5__slack_schedule_message",
      "mcp__3d45de2f-0c7e-4dfe-b321-df8f44b414c5__slack_add_reaction",
      "mcp__3d45de2f-0c7e-4dfe-b321-df8f44b414c5__slack_create_canvas",
      "mcp__3d45de2f-0c7e-4dfe-b321-df8f44b414c5__slack_update_canvas",
      "mcp__3d45de2f-0c7e-4dfe-b321-df8f44b414c5__slack_create_conversation",
      "mcp__0339087b-d306-495a-a244-b46628a59963__slack_send_message",
      "mcp__0339087b-d306-495a-a244-b46628a59963__slack_send_message_draft",
      "mcp__0339087b-d306-495a-a244-b46628a59963__slack_schedule_message",
      "mcp__0339087b-d306-495a-a244-b46628a59963__slack_add_reaction",
      "mcp__0339087b-d306-495a-a244-b46628a59963__slack_create_canvas",
      "mcp__0339087b-d306-495a-a244-b46628a59963__slack_update_canvas",
      "mcp__0339087b-d306-495a-a244-b46628a59963__slack_create_conversation",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_add_reaction",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__claude_ai_Slack__slack_create_conversation",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_send_message_draft",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "mcp__plugin_slack_slack__slack_add_reaction",
      "mcp__plugin_slack_slack__slack_create_canvas",
      "mcp__plugin_slack_slack__slack_update_canvas",
      "mcp__plugin_slack_slack__slack_create_conversation"
    ],
    "ask": [
      "Edit(//e/**)",
      "Edit(//g/**)",
      "Edit(//n/**)",
      "Edit(//p/**)",
      "Edit(//q/**)",
      "Edit(//s/**)"
    ]
  },
  "skipWorkflowUsageWarning": true
}
